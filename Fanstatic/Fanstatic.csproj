<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>fanstatic</AssemblyName>
    <RootNamespace>Fanstatic</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>CS1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <SignAssembly>true</SignAssembly>
    <Authors>Bruno Massa</Authors>
    <PackageLicenseFile>../LICENSE.md</PackageLicenseFile>
    <PackageProjectUrl>https://fanstatic.mass4.com</PackageProjectUrl>
    <PackageTags>static site generator;ssg;yaml/blog</PackageTags>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>7.0.2</Version>
  </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="wwwroot\js\reload.js" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Fanstatic.Generator\Fanstatic.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommandLineParser" Version="2.9.1" />
        <PackageReference Include="Fluid.Core" Version="2.40.0" />
        <PackageReference Include="FolkerKinzel.MimeTypes" Version="5.6.0" />
        <PackageReference Include="Markdig" Version="1.3.2" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
        <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" Version="18.1.0" />
        <PackageReference Include="YamlDotNet" Version="18.1.0" />
    </ItemGroup>

</Project>
